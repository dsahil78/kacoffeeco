# ---------------------------------------------------------------------------
# Kick Ass Coffee Co. — environment
# Copy to `.env` (or `.env.local`) and fill in. NEVER commit the filled-in file.
# Both files are read; `.env.local` wins, matching Vite's precedence.
# ---------------------------------------------------------------------------

# --- SERVER ONLY -----------------------------------------------------------
# Read by the Express app (local dev + the Vercel serverless function).
# These must never be referenced from anything under src/ — Vite only inlines
# variables prefixed with VITE_, which is exactly the boundary we rely on.

# Hyperswitch secret key, from Dashboard → Developers → API Keys.
# Sandbox keys look like: snd_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HYPERSWITCH_SECRET_KEY=snd_replace_me

# Business profile id, from Dashboard → Settings → Business Profile.
# Looks like: pro_xxxxxxxxxxxxxxxxxxxx  (optional — omit to use the default profile)
HYPERSWITCH_PROFILE_ID=

# Payment response hash key for the SAME business profile.
# Signs both the return_url redirect and outgoing webhooks (HMAC-SHA512).
# 64-char random string, shown/generated in the business profile settings.
HYPERSWITCH_PAYMENT_RESPONSE_HASH_KEY=replace_me

# Hyperswitch API base. Sandbox for this prototype.
HYPERSWITCH_BASE_URL=https://sandbox.hyperswitch.io

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Supabase SERVICE ROLE key — bypasses RLS. Server-only, never ship to a browser.
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Public origin of the deployed app. Used to build the Hyperswitch return_url.
# Local dev: http://localhost:5173 · Vercel: https://your-app.vercel.app
APP_BASE_URL=http://localhost:5173

# Port for the local Express dev server (Vite proxies /api here).
PORT=3001


# --- CLIENT (public, inlined into the JS bundle at build time) --------------
# Anything with a VITE_ prefix ends up in the browser. Only public values here.

# Hyperswitch publishable key: pk_snd_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_HYPERSWITCH_PUBLISHABLE_KEY=pk_snd_replace_me

# Leave empty to use same-origin /api (works for both `npm run dev` and Vercel).
VITE_API_BASE_URL=
